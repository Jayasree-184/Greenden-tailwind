# Copy this file to .env and fill in your own key.
# Get a free key at https://resend.com (no credit card needed).
# Without this set, the app still works — it just skips sending the
# welcome email when someone subscribes.
RESEND_API_KEY=

# Admin Authentication (HTTP Basic Auth)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password
